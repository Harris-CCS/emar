		{
			"name": "Get Site Id for tests",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "dc587de0-1a18-4d37-98ff-ba584b923155",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"pm.environment.set(\"SiteId\", jsonData);\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{URL}}/api/sites?sitename=Automation%20Test_Multum",
					"host": [
						"{{URL}}"
					],
					"path": [
						"api",
						"sites"
					],
					"query": [
						{
							"key": "sitename",
							"value": "Automation%20Test_Multum"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "List for Site (no Department no Pt)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "933112ee-7d34-418b-9b08-4cc5b5476ca6",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 25 records\", function() {\r",
							"    pm.expect(jsonData.length).to.eql(25);\r",
							"});\r",
							"\r",
							"pm.test(\"No Links returned\", function() {\r",
							"    pm.expect(jsonData[0].links).to.eql(null);\r",
							"});\r",
							"\r",
							"\r",
							"const validFrequencyScheduleExists = (order) => {\r",
							"    return order.frequencySchedule.id !== 0 && order.frequencySchedule.scheduleName !== undefined && order.frequencySchedule.scheduleName !== \"\";\r",
							"}\r",
							"\r",
							"const validRouteExists = (order) => {\r",
							"    if (order.medicationRoute === null)\r",
							"        return false;\r",
							"    return order.medicationRoute.id !== 0 && order.medicationRoute.routeName !== undefined && order.medicationRoute.routeName !== \"\";\r",
							"}\r",
							"\r",
							"const validUnitExists = (order) => {\r",
							"    if (order.doseUnit === null)\r",
							"        return false;\r",
							"    return order.doseUnit.id !== 0 && order.doseUnit.unitName !== undefined && order.doseUnit.unitName !== \"\";\r",
							"}\r",
							"\r",
							"pm.test(\"All orders have a valid frequency\", function() {\r",
							"    pm.expect(jsonData.all(validFrequencyScheduleExists)).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Route\", function() {\r",
							"    pm.expect(jsonData.any(validRouteExists)).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Unit\", function() {\r",
							"    pm.expect(jsonData.any(validUnitExists)).to.be.true;\r",
							"})\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{URL}}/api/sites/{{SiteId}}/departmentPreferredLists",
					"host": [
						"{{URL}}"
					],
					"path": [
						"api",
						"sites",
						"{{SiteId}}",
						"departmentPreferredLists"
					],
					"query": [
						{
							"key": "patientId",
							"value": "23456",
							"disabled": true
						},
						{
							"key": "departmentCode",
							"value": "Main%20ED",
							"disabled": true
						}
					]
				}
			},
			"response": []
		},
