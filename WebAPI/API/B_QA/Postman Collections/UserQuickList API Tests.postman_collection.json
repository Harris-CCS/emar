	"item": [
		{
			"name": "Testing Values From Database",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "2ab33e9b-8a32-494e-8e24-f18ef1238d43",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.environment.set(\"QuickListUserId\", jsonData.quickListUserId);\r",
							"pm.environment.set(\"QuickListItemId\", jsonData.quickListItemId);\r",
							"pm.environment.set(\"CartOrderPatientId\", jsonData.cartOrderPatientId);\r",
							"pm.environment.set(\"QuickListUserIdTabCount\", jsonData.quickListUserIdTabCount);\r",
							"pm.environment.set(\"QuickListPoundUserId\", jsonData.quickListPoundUserId);\r",
							"pm.environment.set(\"QuickListPoundUserIdTabCount\", jsonData.quickListPoundUserIdTabCount);\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"Ignore_UpdateSiteSixteenFrequencies\": \"with FrequencyCount as (select count(*) as [cnt] from [dbo].[frequency_schedules] where [frequency_schedules].[site_id] = 16), FrequencyIndex as (select row_number() over(order by [id]) - 1 as [idx], [frequency_schedules].[id] as [frequency_id] from [dbo].[frequency_schedules] where [frequency_schedules].[site_id] = 16), ListIndex as (select (row_number() over(order by [id]) - 1) % [FrequencyCount].[cnt] as [idx], [id] as [list_item_id] from [dbo].[user_quick_list_items] cross join [FrequencyCount]) update [d] set [frequency_schedule_id] = [f].[frequency_id] from   [dbo].[user_quick_list_items] [d] inner join [ListIndex] [l] on [d].[id] = [l].[list_item_id] inner join [FrequencyIndex] [f] on [l].[idx] = [f].[idx];\",\r\n    \"cartOrderPatientId\": \"SELECT id FROM patients WHERE site_id = 16 and last_name  = 'Robertson' and first_name = 'Frank'\",\r\n\t\"scheduleId\": \"SELECT id FROM frequency_schedules WHERE REPLACE(notes, ' ', '') = '0000,0400,0800,1200,1600,2000' AND site_id = 16\",\r\n    \"quickListUserId\": \"SELECT TOP 1 user_id FROM user_quick_list_items WHERE site_id = 16 GROUP BY user_id ORDER BY count(*) DESC\",\r\n    \"quickListItemId\": \"SELECT TOP 1 id FROM user_quick_list_items WHERE site_id = 16 and ISNULL(medication_unit_id, 0) > 0 and ISNULL(medication_route_id, 0) > 0 and user_id = <<quickListUserId>>\",\r\n    \"quickListUserIdTabCount\": \"DECLARE @userId int = <<quickListUserId>>; WITH letterCount AS (SELECT DISTINCT UPPER(SUBSTRING([brand_name], 1, 1)) as tab FROM [user_quick_list_items] WHERE UPPER(SUBSTRING([brand_name], 1, 1)) LIKE '[A-Z]' AND [user_id] = @userId) SELECT COUNT(*) + 1 + CASE WHEN EXISTS (SELECT TOP 1 1 FROM [user_quick_list_items] WHERE UPPER(SUBSTRING([brand_name], 1, 1)) NOT LIKE '[A-Z]' AND [user_id] = @userId) THEN 1 ELSE 0 END FROM letterCount;\",\r\n    \"quickListPoundUserId\": \"SELECT user_id FROM user_quick_list_items WHERE site_id = 16 AND UPPER(SUBSTRING([brand_name], 1, 1)) NOT LIKE '[A-Z]';\",\r\n    \"quickListPoundUserIdTabCount\": \"DECLARE @userId int = <<quickListPoundUserId>>; WITH letterCount AS (SELECT DISTINCT UPPER(SUBSTRING([brand_name], 1, 1)) as tab FROM [user_quick_list_items] WHERE UPPER(SUBSTRING([brand_name], 1, 1)) LIKE '[A-Z]' AND [user_id] = @userId) SELECT COUNT(*) + CASE WHEN EXISTS (SELECT TOP 1 1 FROM [user_quick_list_items] WHERE UPPER(SUBSTRING([brand_name], 1, 1)) NOT LIKE '[A-Z]' AND [user_id] = @userId) THEN 1 ELSE 0 END FROM letterCount;\",\r\n    \"Ignore\": \"UPDATE user_quick_list_items SET frequency_schedule_id = <<scheduleId>> WHERE id = <<quickListItemId>>;\",\r\n    \"Ignore2\": \"update [dbo].[user_quick_list_items] set [weekly_usage_rolling_average] = -1 where user_id = <<quickListUserId>>; set rowcount 100; update [dbo].[user_quick_list_items] set [weekly_usage_rolling_average] = 1.0 where user_id = <<quickListUserId>>; set rowcount 80; update [dbo].[user_quick_list_items] set [weekly_usage_rolling_average] = 1.0 where user_id = <<quickListUserId>>; set rowcount 60; update [dbo].[user_quick_list_items] set [weekly_usage_rolling_average] = 1.0 where user_id = <<quickListUserId>>; set rowcount 40; update [dbo].[user_quick_list_items] set [weekly_usage_rolling_average] = 1.0 where user_id = <<quickListUserId>>; set rowcount 20; update [dbo].[user_quick_list_items] set [weekly_usage_rolling_average] = 1.0 where user_id = <<quickListUserId>>; set rowcount 0;\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{URL}}/api/testingvariables",
					"host": [
						"{{URL}}"
					],
					"path": [
						"api",
						"testingvariables"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET quicklist (Initial Call: >80 Most Used)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "a8330d4a-1b89-401e-886f-73f742ea12ea",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 80 records\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.length).to.eql(80);\r",
							"});\r",
							"\r",
							"pm.test(\"Returns correct number of tabs\", function() {\r",
							"    pm.expect(jsonData.tabListing.length.toString()).to.eql(pm.environment.get(\"QuickListUserIdTabCount\"));\r",
							"});\r",
							"\r",
							"pm.test(\"Correct Tab Name returned\", function() {\r",
							"    pm.expect(jsonData.currentTab.tabName).to.eql(\"Most Used\");\r",
							"});\r",
							"\r",
							"const validFrequencyScheduleExists = (order) => {\r",
							"    return order.frequencySchedule.id !== 0 && order.frequencySchedule.scheduleName !== undefined && order.frequencySchedule.scheduleName !== \"\";\r",
							"}\r",
							"\r",
							"const validRouteExists = (order) => {\r",
							"    if (order.medicationRoute === null)\r",
							"        return false;\r",
							"    return order.medicationRoute.id !== 0 && order.medicationRoute.routeName !== undefined && order.medicationRoute.routeName !== \"\";\r",
							"}\r",
							"\r",
							"const validUnitExists = (order) => {\r",
							"    if (order.doseUnit === null)\r",
							"        return false;\r",
							"    return order.doseUnit.id !== 0 && order.doseUnit.unitName !== undefined && order.doseUnit.unitName !== \"\";\r",
							"}\r",
							"\r",
							"pm.test(\"All orders have a valid frequency\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.all(validFrequencyScheduleExists)).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Route\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.any(validRouteExists)).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Unit\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.any(validUnitExists)).to.be.true;\r",
							"})\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
