							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"UserQuickListItemId recorded\", function() {\r",
							"    pm.expect(jsonData.userQuickListItemId.toString()).to.be.eql(pm.environment.get(\"QuickListItemId\"));\r",
							"})\r",
							"\r",
							"pm.test(\"User Object exists\", function() {\r",
							"    pm.expect(jsonData.user).to.not.eql(null);\r",
							"})\r",
							"\r",
							"pm.test(\"Unit Object exists\", function() {\r",
							"    pm.expect(jsonData.doseUnit).to.not.eql(null);\r",
							"})\r",
							"\r",
							"pm.test(\"Frequency Object exists\", function() {\r",
							"    pm.expect(jsonData.frequencySchedule).to.not.eql(null);\r",
							"})\r",
							"\r",
							"pm.test(\"Route Object exists\", function() {\r",
							"    pm.expect(jsonData.medicationRoute).to.not.eql(null);\r",
							"})\r",
							"\r",
							"const validateAdmins = (admins) => {\r",
							"    if(admins.length < 12)\r",
							"        return false;\r",
							"    if(new Date(admins[0].administrationScheduledDatetime) < new Date())\r",
							"        return false;\r",
							"    \r",
							"    var todayAdmins;\r",
							"    if(new Date().getHours() < 4)\r",
							"        todayAdmins = 5;\r",
							"    else if (new Date().getHours() < 8)\r",
							"        todayAdmins = 4;\r",
							"    else if (new Date().getHours() < 12)\r",
							"        todayAdmins = 3;\r",
							"    else if (new Date().getHours() < 16)\r",
							"        todayAdmins = 2;\r",
							"    else if (new Date().getHours() < 20)\r",
							"        todayAdmins = 1;\r",
							"    else\r",
							"        todayAdmins = 0;\r",
							"\r",
							"    if(admins.length != 12 + todayAdmins)\r",
							"        return false;\r",
							"\r",
							"    return true;\r",
							"}\r",
							"\r",
							"pm.test(\"Admin Validation\", function() {\r",
							"    pm.expect(validateAdmins(jsonData.cartOrderAdministrations)).to.be.true;\r",
							"})\r",
