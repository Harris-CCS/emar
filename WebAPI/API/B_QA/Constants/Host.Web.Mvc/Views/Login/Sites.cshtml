@model Host.Web.Mvc.Models.Sites
@{
    ViewBag.Title = "Select a Site";
}

<h1>Sites</h1>

@using (Html.BeginForm("Sites", "Login"))
{
    <input name="id" type="hidden" value="@Model.Id"/>

    foreach (var site in Model.AvailableSites)
    {
        <div class="radio">    
            @Html.RadioButton("siteId", site.Id)
            @Html.Label(site.Name)
        </div>
    }

    <div class="form-group">
        <button class="btn btn-primary">Select</button>
    </div>

    if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible">
            @ViewData.ModelState.FirstOrDefault().Value
        </div>
    }
}