<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <ADUsesOwinOrOpenIdConnect>False</ADUsesOwinOrOpenIdConnect>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>ross-57-patch.picis.com</MSDeployServiceURL>
    <DeployIisAppPath>Host.Web.Mvc</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName />
    <_SavePWD>False</_SavePWD>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="PulseCheck.Membership" Order="1" Enabled="False">
          <Destination Path="Data Source=ross-ed4.picis.com;Initial Catalog=PulseCheck.Membership;Integrated Security=True" Name="server=ross-ed4.picis.com;database=PulseCheck.Membership;trusted_connection=yes;" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=.;Initial Catalog=PulseCheck.Membership;Integrated Security=True" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\PulseCheck.Membership_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="server=.;database=PulseCheck.Membership;trusted_connection=yes;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
        <ObjectGroup Name="IbexContext" Order="2" Enabled="False">
          <Destination Path="Data Source=ross-57-patch.picis.com;Initial Catalog=ibex;Persist Security Info=True;User ID=ibexapi;Password=!bex" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=.;Initial Catalog=ibex;User ID=ibexapi;Password=!bex" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\IbexContext_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Server=.;Database=ibex;User Id=ibexapi;Password=!bex;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)IbexContext-Web.config Connection String">
      <ParameterValue>Data Source=ross-57-patch.picis.com;Initial Catalog=ibex;Persist Security Info=True;User ID=ibexapi;Password=!bex</ParameterValue>
    </MSDeployParameterValue>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)PulseCheck.Membership-Web.config Connection String">
      <ParameterValue>server=ross-ed4.picis.com;database=PulseCheck.Membership;trusted_connection=yes;</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>