		{
			"name": "GET quicklist (Initial Call: >80 Most Used)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "a8330d4a-1b89-401e-886f-73f742ea12ea",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 80 records\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.length).to.eql(80);\r",
							"});\r",
							"\r",
							"pm.test(\"Returns 27 tabs\", function() {\r",
							"    pm.expect(jsonData.tabListing.length).to.eql(27);\r",
							"});\r",
							"\r",
							"pm.test(\"Correct Tab Name returned\", function() {\r",
							"    pm.expect(jsonData.currentTab.tabName).to.eql(\"Most Used\");\r",
							"});\r",
							"\r",
							"const validFrequencyScheduleExists = (order) => {\r",
							"    return order.frequencySchedule.id !== 0 && order.frequencySchedule.scheduleName !== undefined && order.frequencySchedule.scheduleName !== \"\";\r",
							"}\r",
							"\r",
							"const validRouteExists = (order) => {\r",
							"    if (order.medicationRoute === null)\r",
							"        return false;\r",
							"    return order.medicationRoute.id !== 0 && order.medicationRoute.routeName !== undefined && order.medicationRoute.routeName !== \"\";\r",
							"}\r",
							"\r",
							"const validUnitExists = (order) => {\r",
							"    if (order.doseUnit === null)\r",
							"        return false;\r",
							"    return order.doseUnit.id !== 0 && order.doseUnit.unitName !== undefined && order.doseUnit.unitName !== \"\";\r",
							"}\r",
							"\r",
							"pm.test(\"All orders have a valid frequency\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.all(validFrequencyScheduleExists)).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Route\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.any(validRouteExists)).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Unit\", function() {\r",
							"    pm.expect(jsonData.currentTabContents.any(validUnitExists)).to.be.true;\r",
							"})\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"protocolProfileBehavior": {
				"disabledSystemHeaders": {
					"accept": true
				}
			},
			"request": {
				"method": "GET",
				"header": [
					{
