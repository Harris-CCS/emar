		{
			"name": "Get Site Id for tests",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "a2f24981-20db-4ffb-a2b8-4de182543feb",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"pm.environment.set(\"SiteId\", jsonData);\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{URL}}/api/sites?sitename=FDB%20%2836%29",
					"host": [
						"{{URL}}"
					],
					"path": [
						"api",
						"sites"
					],
					"query": [
						{
							"key": "sitename",
							"value": "FDB%20%2836%29"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "List for Site (no Department no Pt)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "50c89808-9529-4229-a010-965d8c05d7a7",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 13 records\", function() {\r",
							"    pm.expect(jsonData.groups.length).to.eql(13);\r",
							"});\r",
							"\r",
							"pm.test(\"Group 1 has name 'Abdominal Pain'\", function() {\r",
							"    pm.expect(jsonData.groups[0].groupName).to.eql(\"Abdominal Pain\");\r",
							"});\r",
							"\r",
							"pm.test(\"Group 1 has 12 records\", function() {\r",
							"    pm.expect(jsonData.groups[0].orders.length).to.eql(12);\r",
							"});\r",
							"\r",
							"pm.test(\"Links not returned\", function() {\r",
							"    pm.expect(jsonData.groups[0].orders[0].links).to.eql(null);\r",
							"});\r",
							"\r",
							"\r",
							"const validFrequencyScheduleExists = (order) => {\r",
							"    return order.frequencySchedule.id !== 0 && order.frequencySchedule.scheduleName !== undefined && order.frequencySchedule.scheduleName !== \"\";\r",
							"}\r",
							"\r",
							"const validRouteExists = (order) => {\r",
							"    if (order.medicationRoute === null)\r",
							"        return false;\r",
							"    return order.medicationRoute.id !== 0 && order.medicationRoute.routeName !== undefined && order.medicationRoute.routeName !== \"\";\r",
							"}\r",
							"\r",
							"const validUnitExists = (order) => {\r",
							"    if (order.doseUnit === null)\r",
							"        return false;\r",
							"    return order.doseUnit.id !== 0 && order.doseUnit.unitName !== undefined && order.doseUnit.unitName !== \"\";\r",
							"}\r",
							"\r",
							"pm.test(\"All orders have a valid frequency\", function() {\r",
							"    pm.expect(jsonData.groups.every((group) => {\r",
							"        return group.orders.every(validFrequencyScheduleExists)\r",
							"    })).to.be.true;\r",
							"});\r",
							"\r",
							"pm.test(\"Some orders have a valid Route\", function() {\r",
							"    pm.expect(jsonData.groups.any((group) => {\r",
							"        return group.orders.any(validRouteExists)\r",
							"    })).to.be.true;\r",
							"})\r",
							"\r",
							"pm.test(\"Some orders have a valid Unit\", function() {\r",
							"    pm.expect(jsonData.groups.any((group) => {\r",
							"        return group.orders.any(validUnitExists)\r",
							"    })).to.be.true;\r",
							"})\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
