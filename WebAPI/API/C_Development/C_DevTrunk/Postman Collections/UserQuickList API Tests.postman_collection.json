		{
			"name": "GET quicklist (Subsequent: \"C\" good site)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "f379ac79-5afd-423a-8e15-74582875aa2f",
						"exec": [
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 91 records\", function () {\r",
							"    pm.expect(jsonData.length).to.eql(91);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Has correct HATEOAS links\", function () {\r",
							"    var quicklistId = jsonData[0].id;\r",
							"    var expectedLink = pm.environment.get(\"URL\") + \"/api/userquicklists/\" + quicklistId + \"/cartOrders/12345\";\r",
							"    pm.expect(jsonData[0].links[0].href).to.eql(expectedLink);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
