		{
			"name": "Get Site Id for tests",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "3d07d3c6-6b13-4ec7-b981-a4708c4437f7",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"pm.environment.set(\"SiteId\", jsonData);\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{URL}}/api/sites?sitename=FDB%20%2836%29",
					"host": [
						"{{URL}}"
					],
					"path": [
						"api",
						"sites"
					],
					"query": [
						{
							"key": "sitename",
							"value": "FDB%20%2836%29"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "List for Site (no Department no Pt)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "99286fd2-98da-480c-95a6-36d8a7ef586a",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 13 records\", function() {\r",
							"    pm.expect(jsonData.groups.length).to.eql(13);\r",
							"});\r",
							"\r",
							"pm.test(\"Group 1 has name 'Abdominal Pain'\", function() {\r",
							"    pm.expect(jsonData.groups[0].groupName).to.eql(\"Abdominal Pain\");\r",
							"});\r",
							"\r",
							"pm.test(\"Group 1 has 12 records\", function() {\r",
							"    pm.expect(jsonData.groups[0].orders.length).to.eql(12);\r",
							"});\r",
							"\r",
							"pm.test(\"Links not returned\", function() {\r",
							"    pm.expect(jsonData.groups[0].orders[0].links).to.eql(null);\r",
							"});\r",
							"\r",
							"pm.test(\"route returned\", function() {\r",
							"    pm.expect(jsonData.groups[0].orders[0].medicationRoute).to.not.eql(null);\r",
							"});\r",
							"\r",
							"pm.test(\"doseUnit returned\", function() {\r",
							"    pm.expect(jsonData.groups[0].orders[5].doseUnit).to.not.eql(null);\r",
							"});\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
