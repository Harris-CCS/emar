	"item": [
		{
			"name": "List for Site (no Department no Pt)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "2072b3ad-9f8e-43a5-ad77-23cfd6530539",
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Returns 5 records\", function() {\r",
							"    pm.expect(jsonData.length).to.eql(5);\r",
							"});\r",
							"\r",
							"pm.test(\"No Links returned\", function() {\r",
							"    pm.expect(jsonData[0].links).to.eql(null);\r",
							"});\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
