		{
			"name": "Setup Environment",
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"Ignore1\": \"WITH src AS (SELECT 16 as site_id, o.id as option_id, t.option_value FROM (VALUES ('MEDINPAT', 'Y') ,('MEDOUTPAT', 'Y') ,('MEDPYXIS', 'Y') ,('MEDEXACTMATCH', 'N')) t (option_name, option_value) JOIN options o ON t.option_name = o.name) UPDATE t SET t.option_value = src.option_value FROM site_options t JOIN src ON src.option_id = t.option_id and src.site_id = t.site_id;\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{URL}}/api/testingvariables",
					"host": [
						"{{URL}}"
					],
					"path": [
						"api",
						"testingvariables"
					]
				}
			},
			"response": []
		},
