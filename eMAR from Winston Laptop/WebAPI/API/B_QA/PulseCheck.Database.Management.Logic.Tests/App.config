<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <connectionStrings>
    <add name="IBEX" providerName="System.Data.SqlClient" connectionString="Data Source=(local);Initial Catalog=ibex;Integrated Security=SSPI;" />
    <add name="IBEX_ARCHIVE" providerName="System.Data.SqlClient" connectionString="Data Source=(local);Initial Catalog=ibex_archive;Integrated Security=SSPI;" />
  </connectionStrings>
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
      </layout>
    </appender>
    <root name="LogLevelRoot">
      <level value="DEBUG" />
      <appender-ref ref="ConsoleAppender" />
    </root>

  </log4net>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
</configuration>